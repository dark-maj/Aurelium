# ==============================================================================
# Aurelium AI Service Environment Configuration Template
# Placeholder values only - do not commit real credentials to source control.
# ==============================================================================

# --- xAI / Grok Configuration ---
XAI_API_KEY=xai-placeholder-key
XAI_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7
JUDGE_MODEL=grok-4.7

# --- Pinecone Vector Database ---
PINECONE_API_KEY=pc-placeholder-key
PINECONE_INDEX=aurelium-papers
PINECONE_NAMESPACE=research-papers
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Neon Postgres Relational Database ---
# Pooled URL for serverless application queries (asyncpg driver with SSL)
NEON_DATABASE_URL=postgresql+asyncpg://neondb_owner:placeholder_password@ep-pooler.us-east-2.aws.neon.tech/neondb?ssl=require
# Direct URL for Alembic migrations (bypasses transaction pooler)
NEON_DIRECT_URL=postgresql://neondb_owner:placeholder_password@ep.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Embedding & Vector Dimension ---
EMBEDDING_MODEL=allenai/specter2
EMBEDDING_DIM=768

# --- Retrieval Parameters ---
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.65
MAX_CONTEXT_TOKENS=8192

# --- Application / Environment ---
APP_ENV=development
LOG_LEVEL=INFO
